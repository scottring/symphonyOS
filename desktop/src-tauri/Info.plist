<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app bundle's Info.plist by Tauri. Without the camera usage
     description, macOS TCC denies getUserMedia in the WKWebView outright and
     photo-first capture's live camera can never prompt. -->
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Symphony uses the camera to snap photos of things so AI can identify them and file them as tasks. With an iPhone nearby, Continuity Camera lets the phone act as the camera.</string>
</dict>
</plist>
