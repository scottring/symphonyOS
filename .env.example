# Supabase
VITE_SUPABASE_URL=https://mwadppyrqzuzgstmwpuy.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth (set in Supabase Edge Function secrets, not here)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret

# Google Maps / Places API key — REQUIRED for the directions feature's
# place-autocomplete (origin + destination). Loaded at build time, so it must
# also be set in the Vercel project env (Production/Preview/Development) or the
# deployed app silently shows no Places suggestions.
# Get a key + enable "Maps JavaScript API" and "Places API (New)":
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# OpenWeatherMap API (for weather-based packing recommendations)
# Free tier: 1000 calls/day at https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your-openweather-api-key-here

# Claude API (for AI-powered packing list generation)
# Get API key from https://console.anthropic.com/
# NOTE: For production, move to Supabase Edge Function secrets
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Relish (dinner conversation prompt on the wall kiosk)
VITE_RELISH_DINNER_PROMPT_URL=https://getdinnerprompt-rdflewpdjq-uc.a.run.app/
VITE_RELISH_REPORT_PROMPT_URL=https://reportdinnerprompt-rdflewpdjq-uc.a.run.app/
VITE_RELISH_API_KEY=your-relish-api-key-here
VITE_RELISH_HOUSEHOLD_ID=your-relish-household-id-here

# Sentry (error tracking - only used in production builds)
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Path to Scott's Obsidian vault. Used by the vault-applications Vite plugin
# to read job-application markdown files. Defaults to ~/Documents/scotts-world
# when unset. Override for testing or non-default vault locations.
VITE_VAULT_DIR=
